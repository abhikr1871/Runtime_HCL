# Copy to .env and fill in. NEVER commit .env (it is in .gitignore). Never paste keys in chat.

# LLM provider: groq (default for this team) | ollama | openai (any OpenAI-compatible API)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Optional for reasoning models such as gpt-oss: low | medium | high (empty = provider default)
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=20

# true = the running app makes no LLM calls (rules + templates). Data-kit scripts ignore this.
MOCK_LLM=true

# Only for LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Only for LLM_PROVIDER=openai (another OpenAI-compatible service)
HOSTED_API_URL=
HOSTED_API_KEY=

# Retrieval
EMBED_MODEL=intfloat/multilingual-e5-small
ENABLE_EMBEDDINGS=false
ENABLE_RERANKER=false
# Vector Store: sqlite (default, fast in-memory) | chromadb (persistent ChromaDB collection)
VECTOR_STORE=sqlite
CHROMA_DIR=data/chroma

# Paths (relative to the repo root)
DB_PATH=data/shop.db
MODELS_DIR=models

# UI -> API (127.0.0.1, not localhost: avoids a ~2 s IPv6 delay on Windows)
API_URL=http://127.0.0.1:8000
